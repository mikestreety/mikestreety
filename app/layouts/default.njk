<!DOCTYPE html>
<html lang="en-GB">
<head>
	<meta charset="utf-8">
	{%- set pageTitle = (title + ' - ' + meta.site.title) if title else (meta.site.title + ' - ' + meta.site.description) %}
	{%- if pagination.size !== 1 and pagination.pageNumber %}{% set pageTitle = 'Page ' + (pagination.pageNumber + 1) + ' - ' + pageTitle %}{% endif %}
	{%- set pageDescription = (intro if intro else (description if description else (page.rawInput | excerpt))) | plainText %}
	{%- set pageDescription = pageDescription if pageDescription else (title if title else meta.site.description) %}
	{%- set isPost = parent and page.date and title and not sitemapIgnore %}
	<title>{{ pageTitle }}</title>
	<link rel="home" href="{{ meta.site.url }}/">

	<meta name="viewport" content="width=device-width,initial-scale=1,minimum-scale=1">
	<meta name="generator" content="{{ eleventy.generator }}">

	<link rel="manifest" href="/site.webmanifest">
	<link rel="apple-touch-icon" sizes="180x180" href="/assets/img/favicon-180.png">
	<link rel="apple-touch-icon" sizes="512x512" href="/assets/img/favicon-512.png">
	<link rel="shortcut icon" href="/assets/img/favicon.ico">
	<meta name="msapplication-TileColor" content="{{ meta.themeColour }}">
	<meta name="msapplication-config" content="/browserconfig.xml">
	<meta name="theme-color" content="{{ meta.themeColour }}">

	<meta name="description" content="{{ pageDescription }}">
	<meta name="author" content="{{ meta.author.first_name }} {{ meta.author.last_name }}">

	<link rel="webmention" href="https://webmention.io/www.mikestreety.co.uk/webmention">
	<link rel="pingback" href="https://webmention.io/www.mikestreety.co.uk/xmlrpc">

	<meta property="og:type" content="{{ 'article' if isPost else 'website' }}">
	<meta property="og:title" content="{{ title if title else pageTitle }}">
	<meta property="og:description" content="{{ pageDescription }}">
	<meta property="og:url" content="{{ meta.site.url }}{{ page.url }}">
	<meta property="og:site_name" content="{{ meta.site.title }}">
	<meta property="og:locale" content="en_GB">
	{%- if socialMediaPhoto is defined %}
	<meta property="og:image" content="{{ meta.site.url }}{{ socialMediaPhoto }}">
	<meta property="og:image:width" content="1300">
	<meta property="og:image:height" content="650">
	<meta name="twitter:card" content="summary_large_image">
	<meta name="twitter:image" content="{{ meta.site.url }}{{ socialMediaPhoto }}">
	{%- elif isPost %}
	{%- set ogSubtitle = (parentTitle | replace('Notes', 'Note') | replace('Talks', 'Talk') | replace('Blog', 'Blog post')) + ' · ' + (page.date | dateLong) %}
	<meta property="og:image" content="{{ meta.site.url }}{% ogImage title, ogSubtitle, page.url %}">
	<meta property="og:image:width" content="1200">
	<meta property="og:image:height" content="630">
	<meta property="og:image:alt" content="{{ title }}">
	<meta name="twitter:card" content="summary_large_image">
	<meta name="twitter:image" content="{{ meta.site.url }}{% ogImage title, ogSubtitle, page.url %}">
	{%- else %}
	<meta property="og:image" content="{{ meta.site.url }}/assets/img/mike.jpg">
	<meta property="og:image:width" content="497">
	<meta property="og:image:height" content="500">
	<meta name="twitter:card" content="summary">
	<meta name="twitter:image" content="{{ meta.site.url }}/assets/img/mike.jpg">
	{%- endif %}
	<meta name="twitter:title" content="{{ title if title else pageTitle }}">
	<meta name="twitter:description" content="{{ pageDescription }}">

	<link rel="alternate" type="application/rss+xml" title="Mike Street's Blog Posts" href="/rss.xml">
	<link rel="alternate" type="application/rss+xml" title="Mike Street's Notes" href="/rss-notes.xml">
	<link rel="alternate" type="application/rss+xml" title="Mike Street's Blogs &amp; Notes" href="/rss-all.xml">
	<link rel="alternate" type="application/feed+json" title="Mike Street's Blogs &amp; Notes (JSON Feed)" href="/feed.json">

	{% if sitemapIgnore or draft %}
	<meta name="robots" content="noindex, nofollow">
	{% endif %}

	{% set count = 1 %}

	{% if tags %}
	<meta property="article:published_time" content="{{ page.date | dateISO }}">
	{%- if updated %}
	<meta property="article:modified_time" content="{{ updated | dateISO }}">
	{%- endif %}
	<meta property="article:author" content="{{ meta.site.url }}/about/">

	{% for tag in tags -%}
	<meta property="article:tag" content="{{ tag }}">
	{%- endfor %}

	{% set comma = joiner() %}
	<meta name="twitter:label{{ count }}" content="Tags">
	<meta name="twitter:data{{ count }}" content="{% for tag in tags -%}{{ comma() }} {{ tag }}{%- endfor %}">
	{% set count = count + 1 %}

	<meta name="twitter:label{{ count }}" content="Reading time">
	<meta name="twitter:data{{ count }}" content="{{ content | emojiReadTime }}">
	{% set count = count + 1 %}
	{% endif %}

	{% if who %}
	<meta name="twitter:label{{ count }}" content="For">
	<meta name="twitter:data{{ count }}" content="{{ who }}">
	{% set count = count + 1 %}
	{% endif %}

	{% if canonical %}
	<meta name="twitter:label{{ count }}" content="Original link">
	<meta name="twitter:data{{ count }}" content="{{ canonical }}">
	{% set count = count + 1 %}
	{% endif %}

	{% if canonical is defined  %}
	<link rel="canonical" href="{{ canonical }}">
	{% else %}
	<link rel="canonical" href="{{ meta.site.url }}{{ page.url }}">
	{% endif %}

	<link rel="stylesheet" href="/assets/css/style.css">

	<script>
	if ('serviceWorker' in navigator) {
		navigator.serviceWorker.register('/sw.js?1');
	}
	</script>

	<script data-goatcounter="https://mikestreety.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
</head>

<body {% if bodyclass is defined %}class="{{ bodyclass }}"{% endif %}>
	<div class="page" itemscope itemtype="http://schema.org/WebSite">
		<header class="header">
			<div class="container">
				<div class="title">
					<a href="/" class="logo" title="Mike Street">
						<svg xmlns="http://www.w3.org/2000/svg" width="493" height="493" viewbox="0 0 493 493">
							<g fill="none" fill-rule="evenodd">
								<path fill="#fff" d="M492.54 1h.374v325.637H327.51v-106.46L492.538 1Z"/>
								<path fill="#fff" d="m167.604.914 78.8 107.634L326.675.914h165.93L492.54 1H327.51l-.002 219.176-.833 1.108-80.271 105.439L.605.913h166.999Z"/>
								<path fill="#35eb93" d="M492.54 1 327.507 220.178 327.51 1h165.03ZM325.607 382.038h166.998v110.876H325.607zM.605 382.038h166.998v110.876H.605z"/>
							</g>
						</svg>
					</a>
					<a href="/">
						<span>{{ meta.site.title }}</span>
					</a>
				</div>
				<nav class="menu" itemscope itemtype="http://schema.org/SiteNavigationElement">
					<meta itemprop="name" content="Navigation Menu">
					{% set pages = collections.all | eleventyNavigation %}
					<ul>
					{%- for entry in pages %}
						<li>
							<a href="{{ entry.url | url }}" itemprop="url" {% if entry.url == page.url %}class="active"{% endif %}>{{ entry.title }}</a>
						</li>
					{%- endfor %}
					</ul>
				</nav>
			</div>
		</header>

		<main class="content">
			{{ content | safe }}
		</main>

		<footer class="footer">
			<div class="container">
				<ul class="social">
					<li class="mastodon">
						<a rel="me" href="{{ meta.social.mastodon.url }}" title="Follow me on Mastodon">
							Mastodon
						</a>
					</li>

					<li class="bluesky">
						<a href="{{ meta.social.bluesky.url }}" rel="me" title="Follow me on Bluesky">
							Bluesky
						</a>
					</li>

					<li class="linkedin">
						<a href="{{ meta.social.linkedin.url }}" rel="me" title="Connect on LinkedIn">
							LinkedIn
						</a>
					</li>

					<li class="github">
						<a href="{{ meta.social.github.url }}" title="Check out my Github" rel="me">
							Github
						</a>
					</li>

					<li class="gitlab">
						<a href="{{ meta.social.gitlab.url }}" title="Check out my Gitlab" rel="me">
							Gitlab
						</a>
					</li>

					<li class="coffee">
						<a href="https://www.buymeacoffee.com/mikestreety" title="Buy me a Coffee">
							Buy me a Coffee
						</a>
					</li>
				</ul>

				<p>
					<a href="/diary/">The diary</a> |
					<a href="/stats/">Stats</a> |
					<a href="/contact/">Contact</a>
					</br>
					<a class="h-card" rel="me" href="https://www.mikestreety.co.uk/">{{ meta.site.title }}</a> | <a href="/rss.xml">Blog RSS</a> | <a href="/rss-notes.xml">Notes RSS</a> | <a href="/rss-all.xml">Full RSS Feed</a>.</p>
			</div>
		</footer>

		<link itemprop="url" href="https://www.mikestreety.co.uk/">
	</div>
	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@graph": [
			{
				"@type": "Person",
				"@id": "{{ meta.site.url }}/#person",
				"name": "{{ meta.author.first_name }} {{ meta.author.last_name }}",
				"url": "{{ meta.site.url }}/",
				"image": "{{ meta.site.url }}/assets/img/mike.jpg",
				"jobTitle": "{{ meta.site.description }}",
				"worksFor": {
					"@type": "Organization",
					"name": "Liquid Light",
					"url": "https://www.liquidlight.co.uk/"
				},
				"homeLocation": {
					"@type": "Place",
					"name": "Brighton, UK"
				},
				"sameAs": [
					"{{ meta.social.mastodon.url }}",
					"{{ meta.social.bluesky.url }}",
					"{{ meta.social.github.url }}",
					"{{ meta.social.gitlab.url }}",
					"{{ meta.social.linkedin.url }}",
					"https://www.instagram.com/mikestreety/"
				]
			},
			{
				"@type": "WebSite",
				"@id": "{{ meta.site.url }}/#website",
				"name": "{{ meta.site.title }}",
				"url": "{{ meta.site.url }}/",
				"inLanguage": "en-GB",
				"author": { "@id": "{{ meta.site.url }}/#person" },
				"publisher": { "@id": "{{ meta.site.url }}/#person" }
			}
		]
	}
	</script>
	<script type="module" src="/assets/js/main.js"></script>
</body>
</html>
